# Copy to .env and fill in. Compose reads this for SESSION_KEY and others.

# --- Server ---
APP__SERVER__HOST=0.0.0.0
APP__SERVER__PORT=3000
APP__SERVER__SHUTDOWN_TIMEOUT_SECS=30
# Only set to true behind a trusted reverse proxy that overwrites X-Forwarded-For.
APP__SERVER__TRUST_FORWARDED_FOR=false

# --- Database (Postgres) ---
DATABASE_URL=postgres://todo:todo@localhost:5432/todo
APP__DATABASE__MAX_CONNECTIONS=20
APP__DATABASE__MIN_CONNECTIONS=2
APP__DATABASE__ACQUIRE_TIMEOUT_SECS=5

# --- Cache (Valkey / Redis) ---
REDIS_URL=redis://localhost:6379
APP__CACHE__POOL_SIZE=10
APP__CACHE__DEFAULT_TTL_SECS=300

# --- Auth / sessions ---
# Generate with `just gen-session-key`  (openssl rand -hex 64 = 128 hex chars = 64 bytes).
# Both vars below MUST be a real 128-hex-char string; the literal placeholder will fail
# startup validation. `just init-env` writes a real value into this file.
APP__AUTH__SESSION_KEY=
APP__AUTH__SESSION_TTL_SECS=2592000
APP__AUTH__COOKIE_SECURE=false
APP__AUTH__COOKIE_DOMAIN=

# Compose-only shortcut (referenced from compose.yaml as ${SESSION_KEY:?}).
# In compose, this gets injected into the app container as APP__AUTH__SESSION_KEY.
SESSION_KEY=

# --- Logging / observability ---
RUST_LOG=info,todo_app=debug,sqlx=warn
APP__OBSERVABILITY__SERVICE_NAME=todo-app
APP__OBSERVABILITY__OTEL_ENDPOINT=http://localhost:4317
APP__OBSERVABILITY__OTEL_ENABLED=false
APP__OBSERVABILITY__LOG_FORMAT=pretty

# --- Templates / static ---
APP__TEMPLATES_DIR=templates
APP__STATIC_DIR=static
APP__TEMPLATE_AUTORELOAD=true
