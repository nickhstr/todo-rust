# ---- Build artifacts ---------------------------------------------------------
/target
**/*.rs.bk
**/*.backup
*.bak
Cargo.lock.bak

# Downloaded Tailwind standalone binary (scripts/install-tailwind.sh)
/bin/

# Tailwind / npm output (regenerated by `npm run build`)
node_modules/
static/css/app.css

# sqlx-cli offline cache — regenerate locally; opt in by removing this line
# and running `just prepare`.
.sqlx/

# Coverage / profiling artifacts
*.profraw
*.profdata
lcov.info
cobertura.xml
tarpaulin-report.html
flamegraph.svg
perf.data
perf.data.old

# ---- Secrets / local config --------------------------------------------------
.env
.env.local
.env.*.local

# direnv / nix-direnv
.envrc.local
.direnv/

# ---- AI / pair-programming tools (user-specific, do NOT commit) --------------
# Claude Code (this project's primary collaborator). The project-level
# CLAUDE.md IS committed; CLAUDE.local.md is the conventional spot for
# user-specific overrides and stays local.
.claude/
CLAUDE.local.md
.playwright-mcp/

# Other AI assistants someone on the team might be using.
.cursor/
.cursorrules
.cursorignore
.aider*
.continue/
.codeium/
.windsurfrules
.specstory/
.github/copilot-instructions.local.md

# ---- Editors / IDEs ----------------------------------------------------------
.idea/
.vscode/
.fleet/
.helix/
.zed/
.nvim.lua
.exrc

# vim swap / undo / netrw
*.swp
*.swo
*.swn
*.un~
.netrwhist

# emacs
*~
\#*\#
.\#*

# ---- OS junk -----------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
Icon[$'\r']
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Linux
.fuse_hidden*
.Trash-*
.nfs*

# ---- Logs / scratch ----------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnpm-store/

tmp/
.tmp/

# Test / screenshot output (playwright, manual captures, etc.)
screenshots/
*.png.tmp
test-results/
playwright-report/

# k6 load test results — local per-run artifacts, large and noisy.
k6/results/*
!k6/results/.gitkeep
