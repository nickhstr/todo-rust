{
  "name": "todo-rust-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Tailwind v4 build pipeline for the editorial todo app.",
  "scripts": {
    "build": "tailwindcss -i ./static/css/app.src.css -o ./static/css/app.css --minify",
    "watch": "tailwindcss -i ./static/css/app.src.css -o ./static/css/app.css --watch=always"
  },
  "devDependencies": {
    "tailwindcss": "^4.0.0",
    "@tailwindcss/cli": "^4.0.0"
  }
}
