        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(k6_checks{scenario=~\"$scenario\", git_sha=~\"$git_sha\"}[30s]))",
          "legendFormat": "checks/s",
          "refId": "A"
        }
      ],
      "title": "Checks per second",
      "type": "timeseries"
